# Node.js port
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/release_notifier

# GitHub API
GITHUB_API_TOKEN=

# Email service (Mailtrap for development)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@release-notifier.local

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# API Key (for API key authentication)
API_KEY_ENABLED=false
API_KEY_TOKEN=

# Scanner interval (in milliseconds)
SCANNER_INTERVAL=3600000

# Max retries for GitHub API
GITHUB_API_MAX_RETRIES=3
GITHUB_API_RETRY_DELAY=1000
